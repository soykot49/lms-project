# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (single source)
# SQLite local example:
# DATABASE_URL=sqlite:////app/db.sqlite3
# PostgreSQL docker example:
DATABASE_URL=postgresql://postgres:postgres@db:5432/library_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery (worker + Beat — schedules in config/beat_schedule.py)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Crontab hours/minutes (Asia/Dhaka — see Django TIME_ZONE)
REMINDER_TASK_HOUR=9
REMINDER_TASK_MINUTE=0
OVERDUE_TASK_HOUR=10
OVERDUE_TASK_MINUTE=0
RESERVATION_TASK_HOUR=11
RESERVATION_TASK_MINUTE=0
OVERDUE_EVENING_TASK_HOUR=18
OVERDUE_EVENING_TASK_MINUTE=0
